Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Один адрес для поисковиков: http и www → https://metalbaza.kz
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^metalbaza\.kz$ [NC]
  RewriteRule ^ https://metalbaza.kz%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Блог и админка — PHP на хостинге (static/_blog/, static/admin/)
  # Служебные файлы блога снаружи не открываются: 404 через rewrite, а не запрет доступа (Require) —
  # отказы доступа попадают в лог ошибок, и fail2ban хостинга банит IP (так забанило нас самих).
  RewriteCond %{THE_REQUEST} \s/+_blog/ [NC]
  RewriteRule ^ - [R=404,L]
  RewriteRule ^api/(_|config\.php) - [R=404,L]
  RewriteRule ^blog$ /blog/ [L,R=301]
  RewriteRule ^blog/([a-z0-9-]+)$ /blog/$1/ [L,R=301]
  RewriteRule ^$ _blog/router.php?route=home [L]
  RewriteRule ^sitemap\.xml$ _blog/router.php?route=sitemap [L]
  RewriteRule ^llms\.txt$ _blog/router.php?route=llms [L]
  RewriteRule ^blog/$ _blog/router.php?route=index [L]
  RewriteRule ^blog/media/([A-Za-z0-9._-]+)$ _blog/router.php?route=media&f=$1 [L]
  RewriteRule ^blog/([a-z0-9-]+)/$ _blog/router.php?route=article&slug=$1 [L]
  RewriteRule ^admin$ /admin/ [L,R=301]
  RewriteRule ^admin/$ admin/index.php [L]
  RewriteRule ^admin/(api|preview)/(.*)$ admin/api.php?r=$1/$2 [L,QSA]

  # Страницы без слеша на конце → со слешем
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Защита страниц (CSP) пока только собирает отчёты, ничего не блокирует; сводка — в пульте admin.alfimov.kz
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com https://cdn.jsdelivr.net; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://e1-0850197d5e074be58352ddc860645af6.ecs.us-east-1.on.aws; frame-src 'self' https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; report-uri /api/csp-report.php"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>
