Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Один адрес для поисковиков: http и www → https://metalbaza.kz
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^metalbaza\.kz$ [NC]
  RewriteRule ^ https://metalbaza.kz%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Блог и админка — PHP на хостинге (static/_blog/, static/admin/)
  # Служебные файлы блога снаружи не открываются: 404 через rewrite, а не запрет доступа (Require) —
  # отказы доступа попадают в лог ошибок, и fail2ban хостинга банит IP (так забанило нас самих).
  RewriteCond %{THE_REQUEST} \s/+_blog/ [NC]
  RewriteRule ^ - [R=404,L]
  # то же для закодированных адресов (/%5Fblog/…): проверяем уже раскодированный путь, но только у запроса снаружи —
  # внутренние переходы на _blog/router.php (правила ниже) идут с REDIRECT_STATUS и не задеваются
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^_blog/ - [R=404,L]
  RewriteRule ^api/(_|config\.php) - [R=404,L]
  RewriteRule ^blog$ /blog/ [L,R=301]
  RewriteRule ^blog/([a-z0-9-]+)$ /blog/$1/ [L,R=301]
  RewriteRule ^$ _blog/router.php?route=home [L]
  RewriteRule ^sitemap\.xml$ _blog/router.php?route=sitemap [L]
  RewriteRule ^llms\.txt$ _blog/router.php?route=llms [L]
  RewriteRule ^llms-full\.txt$ _blog/router.php?route=llms-full [L]
  RewriteRule ^blog/$ _blog/router.php?route=index [L]
  RewriteRule ^blog/media/([A-Za-z0-9._-]+)$ _blog/router.php?route=media&f=$1 [L]
  RewriteRule ^blog/([a-z0-9-]+)/$ _blog/router.php?route=article&slug=$1 [L]
  # Блог на казахском (static/_blog/lib.php: blog_path('kk')) — выключен (0% в автопилоте), но маршрут готов
  RewriteRule ^kz/blog$ /kz/blog/ [L,R=301]
  RewriteRule ^kz/blog/([a-z0-9-]+)$ /kz/blog/$1/ [L,R=301]
  RewriteRule ^kz/blog/$ _blog/router.php?route=index&lang=kk [L]
  RewriteRule ^kz/blog/([a-z0-9-]+)/$ _blog/router.php?route=article&slug=$1&lang=kk [L]
  RewriteRule ^admin$ /admin/ [L,R=301]
  RewriteRule ^admin/$ admin/index.php [L]
  RewriteRule ^admin/(api|preview)/(.*)$ admin/api.php?r=$1/$2 [L,QSA]

  # Страницы без слеша на конце → со слешем
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # Адрес из одного слова, которого нет (ИИ в статьях ссылался на «/slug/» без «/blog/»): если есть похожая
  # статья — 301 на неё, иначе страница «не найдено» (engine: _blog/router.php route=guess)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ _blog/router.php?route=guess&slug=$1 [L]
</IfModule>

<IfModule mod_setenvif.c>
  # CSP enforced только на чисто статических страницах (build.py: page(), без единого PHP-роута на них);
  # остальное (переменная CSP_SOFT) — на Report-Only.
  # ВАЖНО: Request_URI после внутреннего rewrite на некоторых хостингах отражает путь ПОСЛЕ rewrite
  # (_blog/router.php), а не исходный (/, /blog/…) — ловим обе формы сразу, см. alfimov.kz/static/.htaccess,
  # где это всплыло на проде (Plesk), хотя локально Apache вёл себя иначе.
  SetEnvIf Request_URI "^/(blog|kz/blog|admin|api)(/|$)" CSP_SOFT
  SetEnvIf Request_URI "^/$" CSP_SOFT
  SetEnvIf Request_URI "_blog/router\.php" CSP_SOFT
  SetEnvIf Request_URI "admin/(index|api)\.php" CSP_SOFT
</IfModule>
<IfModule mod_headers.c>
  # X-Content-Type-Options: хостинг (Plesk/nginx) уже шлёт nosniff сам — свою строку убрали, была задвоена.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Инлайн-скрипты и инлайн-стили исключены (style.css: .flow-i-N/.flow-n-N) либо разрешены по точному
  # sha256-хэшу содержимого (build.py: csp_hash → 'sha256-+1b4XAZbEGwAndLG4SnAz9vyOvaW/mzEWvPtQr3Gr3A=' 'sha256-/TATvQ5g5MaV5JFhJoGDLBGIgoObf5nvFTBce5S6+pg=' 'sha256-53fDt1KZzzEWCqEZYAt7A7hFWi/8W6jaXse8EdK7opc=' 'sha256-8rj4wIMfpPPUCKTbApFfl8CXgPJ0WaQjiIqYAAIuQUg=' 'sha256-BY8jFQLA0dXcYFeZISFVG9nNFlaWf3aWNQPZd2a0TYg=' 'sha256-CtXPWmiadsq0VZlFa8PETz3UxYxuneaMGxcKCd0QNU8=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-Gntwp7hHwXtGs8QXgUZu1HbzCJKe5Cp3kV9PDTkZgUU=' 'sha256-K4laIynqIgGlSgdIK9ncSZ6QnVBA7rlhN1Gl0kxzvas=' 'sha256-K7WT8EkUduKZxlg+LSpBQgdE1Nt55+afeGY7ZBtbORY=' 'sha256-L7CU19nzX0tRHpKexjRjvRWDRO4hjv5diJm17k7V6kY=' 'sha256-MBCvBqx6Z6hnZQWe/zzVrONRbF37FavR4e3Tj6MUTm4=' 'sha256-NkSPC6TpNveXD7L557UW3/6DJgXJDfx5YtfsYS4aS1o=' 'sha256-OXYGndzm+v1vX3dxT3y6O5Blv6zmtsJsfhDgLX+N2mE=' 'sha256-Q2ysG8WAyMDMW1iv/yxABib1mWJbLP4yN0E2ClyI7+E=' 'sha256-QRDMfR/FXP4f0yQqoNNUCr9y4S7Erb9tL2V8WTDrSqM=' 'sha256-QdKxdgbtac9mKHBlJVfiSOH0qSOwkaSfoui+PpDuU5w=' 'sha256-TPNehZwADSWjW8TkoJTRUutPZBVzrNNdnMP4rb+/Kec=' 'sha256-Tv2pRdxB0jG83mnG12EjRhx9+W5mgAicOi60knenh+Q=' 'sha256-WU7ILmmQ1a+qgTdm4fk9BmU8HZ+qH8LNrr+BzbsDB9k=' 'sha256-WkoQ42okBJkBXutI9n+2b9ntrdpFhX162adsygFCd1o=' 'sha256-WlJ6d6jPklrpp2A83YPQSUk0M4GUnw+uRdk0720osn0=' 'sha256-XaVs6bnWDkbHRZXZf0EtmFkJE1+hSyomldcTfHk2zsQ=' 'sha256-aJ4+qi7dr7si/rzn5zgKFuj/szndeiwFK2S8zX/dC98=' 'sha256-e+hzQL7IVO+UaeSGiQMTHC0Hf26j6IRF9ErI29IA0Bg=' 'sha256-ehHoJMKMkY6xeoAi+9MF9vC5QPjL146fBmmATj4W6DU=' 'sha256-g82kSM5VOnmoLI69J+84OrI80+Vqea+5PpPA7NMjhFY=' 'sha256-gq1HmK7LxHZpsHzRgGDvGTdtRKwOMqMM/006t3JFFq8=' 'sha256-jPNQzJvv0tw1Qou8sudLHDOWCNHmluVUVjtfRijxAZQ=' 'sha256-kKB3DqBeq2EU6SVeG86IJyunxkPNHOJNUbnuDZhCma0=' 'sha256-lBstGpe5CDDrbKfiWUOPYJNd+hiLCBxnZoe6QqE5Y4k=' 'sha256-o/+Ud+5WJM3G1YjDWLngiyeTQn+YhgY4r3Z7MDOZbhM=' 'sha256-ooR8hDHYbsyzgtov+L49gHLhx9jALQRi+peIXbI2g5k=' 'sha256-rj1tp4ikFBP8g4MzvmQwFN658tTkPheSAtQ76Zi7Meg=' 'sha256-runRnTsv13JoFQ/LGZJzyWQ3A51QXnRhJQxtfIged1g=' 'sha256-x01599F4rrJMrb8E15WEliFRV/bXR0WMX2UmzDEiERc=' 'sha256-xFm5W/4VBQPjWAin9e0AVpgco03M82IL02ZhsKAIY5U=' 'sha256-zncCdkm6UwJ1r0q90P2tKcU1++lmfp/sUp/P5dGGJaM=' 'sha256-zpzfUdYCtQQB6MI0wNFnogeNVjSx3vyzN+e7M/0xeNw=' ниже, подставляет build() в конце).
  # CSP_SOFT (см. SetEnvIf выше) — весь блог включая главную (PHP, _blog/router.php: route=home вставляет
  # карточки статей с inline style="margin:…" мимо build.py — lib.php:render_home(); route=index/article —
  # JSON-LD статьи меняется на лету из админки) и админка (вся SPA — один большой инлайн-скрипт).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+1b4XAZbEGwAndLG4SnAz9vyOvaW/mzEWvPtQr3Gr3A=' 'sha256-/TATvQ5g5MaV5JFhJoGDLBGIgoObf5nvFTBce5S6+pg=' 'sha256-53fDt1KZzzEWCqEZYAt7A7hFWi/8W6jaXse8EdK7opc=' 'sha256-8rj4wIMfpPPUCKTbApFfl8CXgPJ0WaQjiIqYAAIuQUg=' 'sha256-BY8jFQLA0dXcYFeZISFVG9nNFlaWf3aWNQPZd2a0TYg=' 'sha256-CtXPWmiadsq0VZlFa8PETz3UxYxuneaMGxcKCd0QNU8=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-Gntwp7hHwXtGs8QXgUZu1HbzCJKe5Cp3kV9PDTkZgUU=' 'sha256-K4laIynqIgGlSgdIK9ncSZ6QnVBA7rlhN1Gl0kxzvas=' 'sha256-K7WT8EkUduKZxlg+LSpBQgdE1Nt55+afeGY7ZBtbORY=' 'sha256-L7CU19nzX0tRHpKexjRjvRWDRO4hjv5diJm17k7V6kY=' 'sha256-MBCvBqx6Z6hnZQWe/zzVrONRbF37FavR4e3Tj6MUTm4=' 'sha256-NkSPC6TpNveXD7L557UW3/6DJgXJDfx5YtfsYS4aS1o=' 'sha256-OXYGndzm+v1vX3dxT3y6O5Blv6zmtsJsfhDgLX+N2mE=' 'sha256-Q2ysG8WAyMDMW1iv/yxABib1mWJbLP4yN0E2ClyI7+E=' 'sha256-QRDMfR/FXP4f0yQqoNNUCr9y4S7Erb9tL2V8WTDrSqM=' 'sha256-QdKxdgbtac9mKHBlJVfiSOH0qSOwkaSfoui+PpDuU5w=' 'sha256-TPNehZwADSWjW8TkoJTRUutPZBVzrNNdnMP4rb+/Kec=' 'sha256-Tv2pRdxB0jG83mnG12EjRhx9+W5mgAicOi60knenh+Q=' 'sha256-WU7ILmmQ1a+qgTdm4fk9BmU8HZ+qH8LNrr+BzbsDB9k=' 'sha256-WkoQ42okBJkBXutI9n+2b9ntrdpFhX162adsygFCd1o=' 'sha256-WlJ6d6jPklrpp2A83YPQSUk0M4GUnw+uRdk0720osn0=' 'sha256-XaVs6bnWDkbHRZXZf0EtmFkJE1+hSyomldcTfHk2zsQ=' 'sha256-aJ4+qi7dr7si/rzn5zgKFuj/szndeiwFK2S8zX/dC98=' 'sha256-e+hzQL7IVO+UaeSGiQMTHC0Hf26j6IRF9ErI29IA0Bg=' 'sha256-ehHoJMKMkY6xeoAi+9MF9vC5QPjL146fBmmATj4W6DU=' 'sha256-g82kSM5VOnmoLI69J+84OrI80+Vqea+5PpPA7NMjhFY=' 'sha256-gq1HmK7LxHZpsHzRgGDvGTdtRKwOMqMM/006t3JFFq8=' 'sha256-jPNQzJvv0tw1Qou8sudLHDOWCNHmluVUVjtfRijxAZQ=' 'sha256-kKB3DqBeq2EU6SVeG86IJyunxkPNHOJNUbnuDZhCma0=' 'sha256-lBstGpe5CDDrbKfiWUOPYJNd+hiLCBxnZoe6QqE5Y4k=' 'sha256-o/+Ud+5WJM3G1YjDWLngiyeTQn+YhgY4r3Z7MDOZbhM=' 'sha256-ooR8hDHYbsyzgtov+L49gHLhx9jALQRi+peIXbI2g5k=' 'sha256-rj1tp4ikFBP8g4MzvmQwFN658tTkPheSAtQ76Zi7Meg=' 'sha256-runRnTsv13JoFQ/LGZJzyWQ3A51QXnRhJQxtfIged1g=' 'sha256-x01599F4rrJMrb8E15WEliFRV/bXR0WMX2UmzDEiERc=' 'sha256-xFm5W/4VBQPjWAin9e0AVpgco03M82IL02ZhsKAIY5U=' 'sha256-zncCdkm6UwJ1r0q90P2tKcU1++lmfp/sUp/P5dGGJaM=' 'sha256-zpzfUdYCtQQB6MI0wNFnogeNVjSx3vyzN+e7M/0xeNw=' https://connect.facebook.net https://cdn.jsdelivr.net https://www.clarity.ms https://*.clarity.ms; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com https://cdn.jsdelivr.net https://*.clarity.ms https://c.bing.com; connect-src 'self' https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://e1-0850197d5e074be58352ddc860645af6.ecs.us-east-1.on.aws; frame-src 'self' https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; report-uri /api/csp-report.php" env=!CSP_SOFT
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://cdn.jsdelivr.net https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com https://cdn.jsdelivr.net https://*.clarity.ms https://c.bing.com; connect-src 'self' https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://e1-0850197d5e074be58352ddc860645af6.ecs.us-east-1.on.aws; frame-src 'self' https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; report-uri /api/csp-report.php" env=CSP_SOFT
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>
